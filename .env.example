# ==============================================================================
# ACCOUNT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Administrator Authentication (Mandatory)
# Username & Password for primary console administration
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Zetta@admin"
ADMIN_EMAIL="hillssinaitab20@gmail.com"

# Google Cloud OAuth 2.0 Credentials (for connecting Google Accounts)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Authorized redirect URI configured in Google Cloud Console:
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Cryptographic Token Encryption Key (AES-256-GCM)
# 32-byte secret (64 hex characters or 32+ char passphrase) used to encrypt Google refresh tokens at rest.
TOKEN_ENCRYPTION_KEY="generate_32_byte_secure_encryption_key_example_hex64"

# Session Security Secret
SESSION_SECRET="secure_random_session_signing_secret_example"

# AI Studio injected URLs and keys
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
